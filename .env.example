# Copy to .env and fill in. NEVER commit or share the resulting .env file.
# Use a dedicated throwaway Instagram account — NOT your main account.

# --- Option A (RECOMMENDED, especially for new accounts): existing session ---
# No password, no login checkpoint. Get the value by logging into instagram.com
# in a browser, then DevTools (F12) -> Application -> Cookies ->
# https://www.instagram.com -> copy the `sessionid` cookie value.
#INSTAGRAM_SESSIONID=

# --- Option B: username/password login (best with an older spare account) ---
INSTAGRAM_USERNAME=your_throwaway_username
INSTAGRAM_PASSWORD=
# Only needed if the account has 2FA enabled (recommended: turn 2FA off).
#INSTAGRAM_2FA_CODE=
